# ---------------------------------------------------------------------------
# Secrets & local env
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
.secrets/

# ---------------------------------------------------------------------------
# Client specification & internal work log — not ours to publish
#
# CLAUDE.md is the client's business specification (job backlog, KPI
# thresholds, commercial workflow) and PROGRESS.md is the internal work log.
# Both stay local. Keep working from them; they are simply never committed.
# ---------------------------------------------------------------------------
CLAUDE.md
PROGRESS.md

# ---------------------------------------------------------------------------
# Real data guardrail (CLAUDE.md 2.4)
#
# No real deal or borrower data may enter the repo. Raw source documents land
# in data/samples/ and are never committed; only synthetic or public,
# anonymised material belongs in data/gold/ and tests/fixtures/, which ARE
# tracked deliberately.
# ---------------------------------------------------------------------------
data/samples/*
!data/samples/.gitkeep
# Loan tapes and servicer reports, wherever they are dropped.
*.xlsx
*.xls
*.xlsm
!tests/fixtures/**/*.xlsx
!data/gold/**/*.xlsx

# ---------------------------------------------------------------------------
# Model weights & caches — never in git; vLLM pulls these itself
# ---------------------------------------------------------------------------
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
models/
.cache/
huggingface/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Tooling caches & test output
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit*.xml

# ---------------------------------------------------------------------------
# Runtime artefacts
# ---------------------------------------------------------------------------
eval/reports/*
!eval/reports/.gitkeep
.docker-volumes/
*.vhdx
*.log

# ---------------------------------------------------------------------------
# Editors / OS / agent-local settings
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
.claude/settings.local.json
